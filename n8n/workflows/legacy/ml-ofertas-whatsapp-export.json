    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of items) {\n  const results = (item.json && item.json.results) || [];\n  for (const prod of results) {\n    const price = prod.price || 0;\n    const orig = prod.original_price || price;\n    const desc = orig > 0 ? Math.round(((orig - price) / orig) * 100) : 0;\n    if (desc >= 10) {\n      const title = prod.title || \\\"\\\";\n      const thumb = prod.thumbnail || \\\"\\\";\n      out.push({ json: { title, price, link: prod.permalink, image: thumb.replace(\\\"-I.jpg\\\", \\\"-O.jpg\\\"), msg: \\\"🔥 *OFERTA!*\\\\n\\\\n*\\\" + title + \\\"*\\\\n💰 R$ \\\" + price + \\\"\\\\n📉 \\\" + desc + \\\"% OFF\\\" } });\n    }\n  }\n}\nreturn out.slice(0, 5);"
      },
      "id": "c5df4f95-52eb-47a8-82b2-f8459577e7e1",
      "name": "Processador_Ofertas",
      "type": "n8n-nodes-base.code",

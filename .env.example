NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5174
TIMEZONE=America/Porto_Velho
DATABASE_URL=file:./data/offers.db
SESSION_SECRET=troque-por-uma-frase-aleatoria-com-32-caracteres
ENCRYPTION_KEY=
# Deixe ambos vazios no primeiro setup para gerar credenciais aleatórias.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Login com Google: crie um OAuth Client ID (tipo "Aplicativo da Web") no
# Google Cloud Console. Authorized redirect URI = GOOGLE_REDIRECT_URI abaixo.
# Só e-mails já cadastrados como AdminUser conseguem entrar pelo Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio-https.example/api/auth/google/callback

MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_ACCESS_TOKEN=
MERCADO_LIVRE_REDIRECT_URI=https://seu-dominio-https.example
MERCADO_LIVRE_SEARCH_LIMIT=6

# A PA-API foi descontinuada em 15/05/2026. Use credenciais da Creators API quando disponíveis.
AMAZON_ASSOCIATE_TAG=
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=

SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_AFFILIATE_ID=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DESTINATION=
META_GRAPH_API_VERSION=v23.0
# Freios operacionais recomendados pelos guias de distribuição responsável.
WHATSAPP_DAILY_GROUP_LIMIT=15
WHATSAPP_DAILY_TOTAL_LIMIT=100
PRICE_VERIFIER_BATCH_SIZE=20

DRY_RUN=true
# Segunda trava: mantenha false durante toda a homologação com o n8n.
EXTERNAL_PUBLISHING_ENABLED=false
AUTO_APPROVAL=false
# Gere com: openssl rand -base64 32
N8N_API_KEY=8igNYt/SYSNmeI0wOk2GznltKEghQ9GqeLcmlNPIRh4=
# A API inicia automaticamente o perfil dedicado fora da área visível. A
# Central bloqueia headless; os cookies permanecem no perfil local do Chrome.
AFFILIATE_BROWSER_BACKGROUND=true
